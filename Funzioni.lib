# Funzioni per modelli ARIMA

check_stationarity_invertibility = function(model) {

  ar_coefs = model$coef[grep("ar", names(model$coef))]
  ma_coefs = model$coef[grep("ma", names(model$coef))]
  
  ar_roots = if (length(ar_coefs) > 0) polyroot(c(1, -ar_coefs)) else numeric(0)
  ma_roots = if (length(ma_coefs) > 0) polyroot(c(1, ma_coefs)) else numeric(0)
  
  ar_moduli = Mod(ar_roots)
  ma_moduli = Mod(ma_roots)
  
  ar_stationary = all(ar_moduli > 1)
  ma_invertible = all(ma_moduli > 1)
  
  list(stationary = ar_stationary, invertible = ma_invertible)
}

significativita_arima = function(modello_arima) {

  coefficienti = modello_arima$coef
  errori_standard = sqrt(diag(modello_arima$var.coef))
  
  t_values = coefficienti / errori_standard
  
  p_values = 2 * (1 - pnorm(abs(t_values)))
  
  risultati = data.frame(
    Coefficiente = coefficienti,
    `Errore Standard` = errori_standard,
    `Valore t` = t_values,
    `P-value` = p_values
  )
  
  return(risultati)
}


calculate_MSE = function(observed, predicted) {
  mse = mean((observed - predicted)^2)
  return(mse)
}

test.dm = function(fitted1,fitted2,set,M){
for(i in 1:length(set)){
d1 = (set[i]-fitted1[i])^2
d2 = (set[i]-fitted2[i])^2
}
d = mean(d1-d2)
I = round(M^(1/3),0)
gamma_d = cov(d1,d2)
var_d = sum(gamma_d[1:I])
DM = d/sqrt(var_d /M)
return(DM)
}

stat.mod=function(fit.y,maxlag=35,ordini=0)
{
  Coef=fit.y$coef
  Std.Err=sqrt(diag(fit.y$var.coef))
  tstat=fit.y$coef/sqrt(diag(fit.y$var.coef))
  pval=2*pnorm(abs(tstat),lower.tail=F)
  tabella=data.frame(Coef,Std.Err,tstat,pval)
  sigma2=fit.y$sigma2
  names(sigma2)="sigma2"
  loglik=fit.y$loglik
  names(loglik)="loglik"
  BIC=BIC(fit.y)
  names(BIC)="BIC"
  AIC=fit.y$aic
  names(AIC)="AIC"
  cc1=Ljung.Box(fit.y$resid,maxlag,ordini)
  riga0="-------------- Stime dei parametri -----------"
  names(riga0)=" "
  riga="-----------------------------------------------"
  names(riga)=" "
  print(riga0, quote=F)
  print(tabella)
  print(riga, quote=F)
  riga2="-------------Test di Ljung-Box ---------------"
  names(riga2)=" "
  print(c(sigma2,BIC,AIC,loglik))
  print(riga2, quote=F)
  print(t(cc1))
}

# Test di Ljung-Box

Ljung.Box= function (x, lag = 15, param=1)
{
  if (NCOL(x) > 1)
    stop ("x is not a vector or univariate time series")
  DNAME = deparse(substitute(x))
  cor = acf (x, lag.max = lag, plot = FALSE)
  n = length(x)
  PARAMETER = lag-param
  obs = cor$acf[2:(lag+1)]
  STATISTIC = n*(n+2)*sum((1/seq(n-1,n-lag))*obs^2)
  PVAL = 1-pchisq(STATISTIC,lag-param)
  return(list(statistic=STATISTIC,
              gdl = PARAMETER,
              pvalue = PVAL))
}


# Test di Ljung-Box

Ljung.Box.2=function(x, maxlag=20, par=0, all=TRUE)
{
  if (all==TRUE) {
    LB=matrix(0,nrow=maxlag, ncol=3)
    dimnames(LB)=list(NULL, c("statistic", "gdl","pvalue"))
    for (i in (par+1): maxlag) {
      lbi=Ljung.Box(x, lag=i, param=par)
      LB[i,]=c(round(lbi$statistic,2), lbi$gdl, lbi$pvalue)
    }
    plot(LB[,3], type="h", lwd=4, ylim=c(0,1), main="Ljung-Box test", ylab="p-value", xlab="k")
    abline(h=0.05, lty=2, col="red")
    abline(h=0)
  }
  if (all==FALSE) LB=Ljung.Box(x, lag=maxlag, param=par)
  
  return(LB)
}

# Funzione per aggiornemnto livello di aggrgazione
# Data.frame con i rendimenti
# agg.period il periodo di riferimento (esempio 22 per i mensile)

agg.stat=function(r,agg.period){
  a=dim(r)
  N=a[2]
  T=a[1]
  BS=basicStats(r)
  # matrici per la memorizzazione dei risultati
  SK=matrix(0,agg.period,N)
  KU=matrix(0,agg.period,N)
  JBt=matrix(0,agg.period,N)
  JBp=matrix(0,agg.period,N)
  DAt=matrix(0,agg.period,N)
  DAp=matrix(0,agg.period,N)
  KSt=matrix(0,agg.period,N)
  KSp=matrix(0,agg.period,N)
  
  # valori iniziali
  SK[1,]=as.matrix(BS[15,])
  KU[1,]=as.matrix(BS[16,])
  # ciclo per il calcolo degli indicatori
  for (g in 2:agg.period) {
    Tog=floor(T/g)
    That=Tog*g
    r1=as.matrix(r[1:That,])
    Tg=diag(Tog) %x% matrix(1,1,g)
    rg=Tg%*%r1
    BS=basicStats(rg)
    SK[g,]=as.matrix(BS[15,])
    KU[g,]=as.matrix(BS[16,])
  }
  
  for (g in 1:agg.period) {
    Tog=floor(T/g)
    That=Tog*g
    r1=as.matrix(r[1:That,])
    Tg=diag(Tog) %x% matrix(1,1,g)
    rg=Tg %*% r1
    for (i in 1:N) {
      out=jarqueberaTest (rg[,i])
      JBt[g,i]=out@test$statistic
      JBp[g,i]=out@test$p.value
      out=dagoTest(rg[,i])
      DAt[g,i]=out@test$statistic[1]
      DAp[g,i]=out@test$p.value[1]
      out=ksnormTest(rg[,i])
      KSt[g,i]=out@test$statistic[1]
      KSp[g,i]=out@test$p.value[1]
    }
  }
  return(list(SK=SK,KU=KU,JBt=JBt,DAt=DAt,KSt=KSt))
}



# Test ADF

lag.ADF = function(p,lag=21){
  out1 = adfTest(p,lags=lag,type="c")
  sum = summary(out1@test$lm)
  lag.max = 0
  for(i in seq(from = (lag+2), to = 3, by = -1)){
    if(sum$coefficients[i,4] <= 0.1){
      lag.max = i
      return( lag.max - 2 )
    }
  }
}


