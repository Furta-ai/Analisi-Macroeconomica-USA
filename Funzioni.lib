# LM-ARCH test 

lm.test = function(r, k = 5) {
  r2 = r ^ 2
  
  y.l = matrix(NA, nrow = NROW(r), ncol = k)
  
  for (i in 1:k) {
    y.l[, i] = lag.xts(r2, k = i)
  }
  p.val = rep(NA, k)
  p.val = sapply(1:k, function(x) {
    test = summary(lm(r2 ~ y.l[, 1:x]))$r.squared * (nrow(r)-2)
    pchisq(test, x, lower.tail = F)
  })
  
  return(p.val)
}


# Funzione per calcolo test di Diebold-Mariano tra due modelli, dati:
# r = rendimento
# spec0 = specificazione modello 1
# spec1 = specificazione modello 2
# ltrain = training size
# ltest = test size
# frefit = ogni quanto ristima il modello (osservazioni)

dm.test1 = function(r,spec0, spec1, ltrain= 0, ltest = 0, frefit=0){
  ret1=r-mean(r) #Devizione rispetto alla media
  for0=ugarchroll(spec0,data=ret1,forecast.length=ltest,refit.every=frefit,window.size=ltrain,refit.window="moving")
  for1=ugarchroll(spec1,data=ret1,forecast.length=ltest,refit.every=frefit,window.size=ltrain,refit.window="moving")
  for0d=as.data.frame(for0)
  for1d=as.data.frame(for1)
  s0f=for0d$Sigma
  s1f=for1d$Sigma
  fall=cbind(s0f,s1f)
  # Diebold - Mariano test
  # valori effettivi (per la proxy della varianza vera)
  rf0=for0d$Realized #rendimenti
  rf1=for1d$Realized #rendimenti
  # Funzioni di perdita
  l0=(s0f^2-rf0^2)
  l1=(s1f^2-rf1^2)
  # Differenziali tra le funzioni di perdita
  d=l0-l1
  library(sandwich)
  m=floor(0.75*((NROW(rf0))^(1/3)))
  x1=as.vector(matrix(1,nrow=NROW(rf0)))
  V=NeweyWest(lm(d~x1-1),lag=m,prewhite=0) #standard error di un modello linerare
  return(mean(d)/sqrt(V))
}


#Funzione confronto criteri di informazione due modelli:
# T:Numero di osservazioni del vettore dei rendimenti su cui sono stati stimati i modelli

cfr.criteri = function(fit1,fit2,T){
  criterio = data.frame(infocriteria(fit1)*T,infocriteria(fit2)*T)
  colnames(criterio) = c("Modello 1","Modello 2")
  criterio$'Si preferisce'
  for(i in 1:4){
    criterio$'Si preferisce'[i] = names(which.min(criterio[i,1:2]))
  }
  return(criterio)
}


#Funzione che calcola il BIC di una modello GARCH:

bic_garch=function(fitted_garch){
  LL=fitted_garch@fit$LLH
  P=length(fitted_garch@fit$coef)
  N=length(fitted_garch@fit$fitted.values)
  (P*log(N))-(2*LL)
}


################################################################################
################################################################################
#######################         FUNZIONI CAPM         ##########################
################################################################################
################################################################################

function.capm = function(Zi,Ze,rf=0){
  beta = matrix(0,ncol(Zi),1)
  betat =   matrix(0,ncol(Zi),1)
  alpha =   matrix(0,ncol(Zi),1)
  alphat =   matrix(0,ncol(Zi),1)
  p.value.beta =  matrix(0,ncol(Zi),1)
  rsqr.adj =   matrix(0,ncol(Zi),1)
  Risk.prem = (rf)*matrix(1,nrow(Zi),ncol(Zi))
  Prem.merc = Ze - rf
  for (i in 1:ncol(Zi)){
    CAPM = lm(Risk.prem[,i] ~ Prem.merc)
    beta[i,1] = CAPM$coefficients[2]
    alpha[i,1] = CAPM$coefficients[1]
    sum = summary(CAPM)
    rsqr.adj[i,1] = sum$r.squared
    alphat[i,1]=sum$coefficients[1,3]
    betat[i,1]=sum$coefficients[2,3]
    
  }
  # Grafico scatter alfa e beta
  plot(beta,alpha,main="Grafico scatter alfa e beta",col.main="red")
  # Grafico beta significativi
  sigbeta=beta*(abs(betat)>1.96)
  plot(sigbeta,main="Grafico beta significativi",col.main="red")
  # Grafico alfa significativi
  sigalpha=alpha*(abs(alphat)>1.96)
  plot(sigalpha,main="Grafico alpha significativi",col.main="red")
  # bar plot degli R-quadro
  barplot(t(rsqr.adj),xlab='Titoli',ylab='adj-R2',main="bar plot degli R-quadro",col.main="red")
  # grafico SML
  ExpRet=colMeans(Zi)
  Rprem=mean(Ze)
  plot(beta,ExpRet,main="Grafico della SML",col.main="red")
  lines(beta,beta*Rprem)
  points(1,Rprem, col="red")
}


cal.capm = function(rf,rE,rM){
  rMe=as.matrix(rM-rf)
  rEe=as.matrix(rE-(as.matrix(rf)%*%matrix(1,1,ncol(rE))))
  alfa=matrix(0,ncol(rE),1)
  beta=matrix(0,ncol(rE),1)
  alfat=matrix(0,ncol(rE),1)
  betat=matrix(0,ncol(rE),1)
  r2a=matrix(0,ncol(rE),1)
  for(i in 1:ncol(rE)){
    out=lm(rEe[,i]~rMe)
    dat=summary(out)
    alfa[i]=dat$coefficients[1,1]
    alfat[i]=dat$coefficients[1,3]
    beta[i]=dat$coefficients[2,1]
    betat[i]=dat$coefficients[2,3]
    r2a[i]=dat$adj.r.squared
  }
  # Grafico scatter alfa e beta
  plot(beta,alfa)
  # Grafico beta significativi
  sigbeta=beta*(abs(betat)>1.96)
  plot(sigbeta)
  # Grafico alfa significativi
  sigalfa=alfa*(abs(alfat)>1.96)
  plot(sigalfa)
  # bar plot degli R-quadro
  barplot(t(r2a),xlab='Titoli',ylab='adj-R2')
  # grafico SML
  ExpRet=colMeans(rEe)
  Rprem=colMeans(rMe)
  plot(beta,ExpRet)
  lines(beta,beta*Rprem)
  points(1,Rprem, col="red")
}

# inferenza nel CAPM
# test congiunto sugli Alfa
# 1- nuova stima per salvare anche i residui
test.CAPM = function(rf,rE,rM){
  N = ncol(rE)
  rMe=as.matrix(rM-rf)
  rEe=as.matrix(rE-(as.matrix(rf)%*%matrix(1,1,N)))
  alfa=matrix(0,N,1)
  beta=matrix(0,N,1)
  alfat=matrix(0,N,1)
  betat=matrix(0,N,1)
  r2a=matrix(0,N,1)
  res=matrix(0,T,N)
  for (i in 1:N){
    out=lm(rEe[,i]~rMe)
    dat=summary(out)
    alfa[i]=dat$coefficients[1,1]  
    alfat[i]=dat$coefficients[1,3]  
    beta[i]=dat$coefficients[2,1]  
    betat[i]=dat$coefficients[2,3]  
    r2a[i]=dat$adj.r.squared
    res[,i]=dat$residuals
  }
  G=cov(res)
  # 2- costruzione della statistica test e calcolo P-value
  testCAPM=T*((1+((mean(rMe)^2)/var(rMe)))^(-1))*(t(alfa)%*%inv(G)%*%alfa)
  df=N
  pvalCAPM=pchisq(testCAPM,df,lower.tail=FALSE)
  return(pvalCAPM)
}
