# Funzione che determina i valori A, B, C e De o plotta la Frontiera Efficiente
# Accesso ai valori nome_variabile[[X]], dove:
# X = 1 --> $A, $B, $C, $De
# X = 2 --> $s / $ro (valori per tracciare F.E.)

front.eff = function(r,do_plot = F){
  #frontiera efficiente non vincolata
  # Vettore di 1
  mS = colMeans(r)
  V = var(r)
  N = ncol(r)
  iv=matrix(1,nrow=N,ncol=1)
  # A, B, C e Delta
  A=t(mS)%*%inv(V)%*%mS
  B=t(iv)%*%inv(V)%*%mS
  C=t(iv)%*%inv(V)%*%iv
  De=A*C-B*B
  # fisso i valori del rendimento obiettivo (arrotondato).
  l=floor(min(mS*100))/100 #minimo rendimento mesile
  u=floor(max(mS*100))/100*4 #massimo rendimento mesile
  #floor funzione che arrotonda
  ro=as.matrix(seq(l,u,by=0.05))
  M=dim(ro)
  s=sqrt(matrix(C/De,M[1],1)*(ro^2)-2*matrix(B/De,M[1],1)*ro + matrix(A/De,M[1],1))
  # Plot FE
  # Solo se do_plot è TRUE, il grafico sarà plottato
  if (do_plot) {
    plot(s, ro, xlab="Rischio", ylab="Rendimento", type="l",
         main="Frontiera Efficiente senza vincolo di positività", col.main="red")
  }
  FE = data.frame(s,ro)
  colnames(FE) = c("s","ro")
  front.par = data.frame(A,B,C,De)
  colnames(front.par) = c("A","B","C","De")
  oggetti = list(front.par,FE)
  return(oggetti)
}

# Funzione che calcola il portafoglio di minima varianza dato un vettore di rendimenti
# Opzione per plottare anche la composizione del portafoglio

port.mv = function(r,do_plot = F){
  mS = colMeans(r)
  V = var(r)
  N = ncol(r)
  iv=matrix(1,nrow=N,ncol=1)
  wGMV=inv(V)%*%iv
  wGMV=wGMV/sum(wGMV)
  rGMV=t(wGMV)%*%mS
  sGMV=t(wGMV)%*%V%*%wGMV
  port = data.frame(sqrt(sGMV),rGMV)
  colnames(port) = c("Volatilità","Rendimento")
  if (do_plot) {
    barplot(t(wGMV),las=2,
            main="Pesi di Portafoglio a Varianza Minima Globale",
            col.main = "red",col="lightblue")
  }
  return(port)
}


# Funzione che calcola il portafoglio di minima varianza dato un vettore di rendimenti
# Opzione per plottare anche la composizione del portafoglio

port.mtoff = function(r,do_plot = F){
  mS = colMeans(r)
  V = var(r)
  N = ncol(r)
  iv=matrix(1,nrow=N,ncol=1)
  wMT=inv(V)%*%mS
  wMT=wMT/sum(wMT)
  rMT=t(wMT)%*%mS
  sMT=t(wMT)%*%V%*%wMT
  port = data.frame(sqrt(sMT),rMT)
  colnames(port) = c("Volatilità","Rendimento")
  if (do_plot) {
    barplot(t(wMT),las=2, main="Pesi di Portafoglio di Massimo Trade-Off",
            col.main = "red",col="lightblue")
  }
  return(port)
}

# Funzione per calcolare la frontiera efficiente con vincolo di positività

front.eff.vinc = function(t,r,do_plot=F,wthmv = F,wthtoff=F){
  #frontiera efficiente con vincolo di positività
  # dati di input - rendimenti in formato xts
  V = var(r)
  library(timeDate)
  Sys.setenv(TZ = "GMT")
  S1V=xts(r,order.by=as.POSIXct(t, tz = "GMT"))
  # determinazione frontiera efficiente e raffronto con non vicolata
  lo.portf=portfolio.spec(assets=colnames(S1V))
  unc.portf=portfolio.spec(assets=colnames(S1V))
  unc.portf=add.constraint(portfolio=unc.portf, type="full_investment")
  lo.portf=add.constraint(portfolio=lo.portf, type="long_only")
  portf.list = combine.portfolios(list(unc.portf, lo.portf))
  if (do_plot) {
    legend.labels = c("Unconstrained", "Long only")
    chart.EfficientFrontierOverlay(R=S1V, portfolio=portf.list, type="mean-StdDev",
                match.col="StdDev",labels.assets=T, pch.assets=18,cex.assets = 0.5,
                legend.loc="topleft",legend.labels=legend.labels, cex.legend=0.6)
    if (wthmv){
      min_var_port_vinc = port.mv.vinc(t,r)
      min_var_port = port.mv(r)
      points(min_var_port$Volatilità,min_var_port$Rendimento,col="red")
      points(sqrt(t(min_var_port_vinc$weights)%*%V%*%min_var_port_vinc$weights),
             t(min_var_port_vinc$weights)%*%colMeans(S1V),pch=20,col="red",bg="red")
    }
    if (wthtoff){
      max_tradeoff_port_vinc = port.mtoff.vinc(t,r)
      max_tradeoff_port = port.mtoff(r)
      points(max_tradeoff_port$Volatilità,max_tradeoff_port$Rendimento,col="green")
      points(max_tradeoff_port_vinc[2],
             max_tradeoff_port_vinc[1],pch=20,col="green")
    }

  }
  
  return(lo.portf)
}

# Funzione che calcola il portafoglio di minima varianza in caso di portafoglio
# vincolato con pesi positivi

port.mv.vinc = function(t,r,do_plot=F){
  library(timeDate)
  Sys.setenv(TZ = "GMT")
  S1V=xts(r,order.by=as.POSIXct(t, tz = "GMT"))
  lo.portf = front.eff.vinc(t,r)
  # Aggiungere obiettivi di massimizzazione del rapporto rendimento-rischio
  lo.portf = add.objective(portfolio = lo.portf, type = "risk", name = "var")
  # Ottimizzare il portafoglio
  min_var_port_vinc = optimize.portfolio(R = S1V, portfolio = lo.portf, optimize_method ="ROI")
  if (do_plot) {
    barplot(t(min_var_port_vinc$weights),las=2, main="Pesi del Portafoglio con varianza minima globale\ncon vincolo di positività",
            col.main = "red",col="lightblue")
  }
  return(min_var_port_vinc)
}

# Funzione che calcola il portafoglio di trade off in caso di portafoglio
# vincolato con pesi positivi

port.mtoff.vinc = function(t,r,do_plot=F){
  library(timeDate)
  Sys.setenv(TZ = "GMT")
  S1V=xts(r,order.by=as.POSIXct(t, tz = "GMT"))
  lo.portf = front.eff.vinc(t,r)
  # Creiamo la frontiera con il portafoglio vincolato
  long.ef = create.EfficientFrontier(R=S1V, portfolio=lo.portf, type="mean-StdDev")
  # Determiniamo portafoglio di massimo trade-off
  k = long.ef$frontier[1:nrow(long.ef$frontier),1]/long.ef$frontier[1:nrow(long.ef$frontier),2]
  max_tf_port_vinc = long.ef$frontier[which.max(k),1:2]
  return(max_tf_port_vinc)
}

# Funzione che calcola il portafoglio di tangenza e plotta il grafico con
# SML, FE, portafoglio di tangenza e minima varianza globale
# Accesso ai valori nome_variabile[[X]], dove:
# X = 1 --> $Volalità / $Rendimento
# X = 2 --> $s1 / $ro1 (valori per tracciare CML)

calcola.prt.tang = function(rf,r,do_plot = F){
  mS = colMeans(r)
  V = var(r)
  N = ncol(r)
  iv=matrix(1,nrow=N,ncol=1)
  FE = front.eff(r)
  l=floor(min(mS*100))/100
  u=floor(max(mS*100))/100*4
  ro=as.matrix(seq(l,u,by=0.05))
  M=dim(ro)
  ro1=as.matrix(seq(rf,u,by=0.05)) # nuova sequenza min e max
  sh=sqrt(FE[[1]]$A-2*FE[[1]]$B*rf+FE[[1]]$C*rf*rf)
  s1=(ro1-rf)%*%(sh^(-1))
  wT= inv(V)%*%(mS-rf) 
  wT=wT/sum(wT)
  rT=t(wT)%*%mS
  sT=t(wT)%*%V%*%wT
  CML = data.frame(s1,ro1)
  colnames(CML) = c("s1","ro1")
  prt.tang = data.frame(sqrt(sT),rT,sh)
  colnames(prt.tang) = c("Volatilità","Rendimento","Sh")
  if (do_plot) {
    plot(s1,ro1,type="l",col="blue",xlab="Rischio",ylab="Rendimento",main="Frontiera efficiente con titolo privo di rischio e rappresenatazione\nportafogli di tangenza e di minima varianza globale",col.main="red")
    lines(FE[[2]]$s,FE[[2]]$ro,type="l")
    points(sqrt(sT),rT,pch=20,col="orange",bg="orange")
    points(0,rf,pch=20,col="red",bg="red")
    legend("topleft",legend = c("Port. di tangenza","rf","F.E.","CML"),
           col=c("orange","red","black","blue"),
           pch = c(20,20,NA,NA),
           lty = c(0, 0,1,1),
           bty = "n",
           cex=0.6)
  }
  oggetti = list(prt.tang,CML,wT)
  return(oggetti)
}


# Funzione che calcola il portafoglio ottimo per un agente avverso al rischio

port.avv.rf = function(rf,r,avv){
  frontiera=front.eff(r)
  w = ((frontiera[[1]]$B-frontiera[[1]]$C*rf)/avv)*port.tang[[3]]
  r_avv = t(w)%*%colMeans(r_titoli) + (1-sum(w))*rf
  s_avv = sqrt(t(w)%*%var(r_titoli)%*%w)
  port.tang = calcola.prt.tang(rf,r_titoli,do_plot = T)
  points(s_avv,r_avv,col="brown",pch=20)
  oggetti = list(w,r_avv,s_avv)
  names(oggetti)=c("pesi","Rendimento","sd")
  return(oggetti)
}

# Funzione che confronta due portfogli di tangenza con in input
# un titoli risk free e i vettori dei log-rendimenti dei
# relativi titoli

confr.grf.tang = function(rf,r,r2){
  CML1 = calcola.prt.tang(rf,r)
  CML2 = calcola.prt.tang(rf,r2)
  FE1 = front.eff(r)
  FE2 = front.eff(r2)
  plot(CML1[[2]]$s1,CML1[[2]]$ro1,type="l",col="blue",xlab="Rischio",ylab="Rendimento",
       main="Confronto frontiere efficienti con titolo privo di rischio e\nrappresenatazione portafogli di tangenza e portafoglio di minima varianza globale",
       col.main="red",cex.main=0.95)
  lines(FE1[[2]]$s,FE1[[2]]$ro,type="l")
  points(CML1[[1]]$Volatilità,CML1[[1]]$Rendimento,pch=20,col="orange",bg="orange")
  lines(CML2[[2]]$s1,CML2[[2]]$ro1,type="l",col="blue")
  lines(FE2[[2]]$s,FE2[[2]]$ro,type="l")
  points(CML2[[1]]$Volatilità,CML2[[1]]$Rendimento,pch=20,col="orange",bg="orange")
  points(0,rf,pch=20,col="red",bg="red")
  legend("topleft",legend = c("Port. di tangenza","rf","F.E.","CML"),
         col=c("orange","red","black","blue"),
         pch = c(20,20,NA,NA),
         lty = c(0, 0,1,1),
         bty = "n",
         cex=0.6)
  #oggetti = list(CML2[[1]]$Rendimento,CML2[[1]]$Volatilità,CML2[[2]]$s1,CML2[[2]]$ro1)
  #return(oggetti)
}

# Funzione che plotta la CLM con l'intervallo di confidenza

ict.sh = function(rf,r){
  port.tang = calcola.prt.tang(rf,r)
  FE = front.eff(r)
  plot(port.tang[[2]]$s1,port.tang[[2]]$ro1,type="l",col="blue",xlab="Rischio",ylab="Rendimento",main="Intervallo di confidenza per la FE",col.main="red")
  points(port.tang[[1]]$Volatilità,port.tang[[1]]$Rendimento,pch=20,col="orange",bg="orange")
  lines(FE[[2]]$s,FE[[2]]$ro,type="l")
  sh = port.tang[[1]]$Sh
  varsh = (1/T)*(1+0.5*sh*sh)
  lines((port.tang[[2]]$ro1-rf)*((sh-sqrt(varsh)*qnorm(0.975))^(-1)),port.tang[[2]]$ro1,
        type="l",col="red",lty=2)
  lines((port.tang[[2]]$ro1-rf)*((sh-sqrt(varsh)*qnorm(0.025))^(-1)),port.tang[[2]]$ro1,
        type="l",col="red",lty=2)
  points(0,rf,col="red",pch=20)
  legend("topleft",legend = c("CML port. di tangenza","port. di tangenza","ICT"),
         col=c("blue","orange","red"),
         pch=c(NA,20,NA),
         lty = c(1,0,2),
         bty = "n",
         cex=0.7)
}


# Test di significatività di una performance di Sharpe

test_sign.sh = function(rf,r){
  port.tang = calcola.prt.tang(rf,r)
  sh = port.tang[[1]]$Sh
  varsh=(1/T)*(1+0.5*sh*sh) 
  tsh=(sqrt(T)*sh)/(sqrt(1+((sh^2)/2)))
  test = sh/sqrt(varsh)
  risultato = abs(test) < 1.96
  lista = list(test,risultato)
  names(lista) = c("Stat. test","Si accetta H0 ?")
  return(lista)
}

# Funzione per calcolare indice di Sharpe di un titolo

calcola.sh = function(rf,titolo){
  mu = mean(titolo)
  sd = sqrt(var(titolo))
  return(sh = (mu-rf)/sd)
}

# Test di significatività di una performance di Sharpe per un unico titolo

test_sign.sh.titolo = function(rf,titolo){
  sh = calcola.sh(rf,titolo)
  varsh=(1/T)*(1+0.5*sh*sh) 
  tsh=(sqrt(T)*sh)/(sqrt(1+((sh^2)/2)))
  test = sh/sqrt(varsh)
  risultato = abs(test) < 1.96
  lista = list(test,risultato)
  names(lista) = c("Stat.test","Si accetta H0 ?")
  return(lista)
}

# Funzione per confronto di performance di sharpe

test.port = function (T,sh1,sh2,rho12){
  a = 2*(1-rho12) + (sh1^2)/2 + (sh2^2)/2 - sh1*sh2*rho12^2
  Statistia.test.CS.F = (sqrt(T)*(sh1-sh2))/sqrt(a)
  test = abs(Statistia.test.CS.F) <= 1.96
  lista = list(Statistia.test.CS.F,test)
  names(lista) = c("Valore stat. test","Esito")
  return(lista)
}


# Funzione che esegue il test d'esclusione dati i due vettori dei log-rendimenti

test.esclusione = function(rf,r,r2){
  N = ncol(r)
  N1 = ncol(r2)
  N2 = N - N1
  T = nrow(r)
  frontiera = front.eff(r)
  sh=sqrt(frontiera[[1]]$A-2*frontiera[[1]]$B*rf+frontiera[[1]]$C*rf*rf) # Indice di Sharpe N titoli
  frontiera2 = front.eff(r2)
  sh2=sqrt(frontiera2[[1]]$A-2*frontiera2[[1]]$B*rf+frontiera2[[1]]$C*rf*rf)
  Excl.test=T*(sh^2-sh2^2)/(1+sh2^2) 
  # P.value
  pval.Excl.test=pchisq(Excl.test,N2,lower.tail=FALSE) #P[X>x]
  tabella = data.frame(sh, sh2, Excl.test, pval.Excl.test)
  colnames(tabella) = c("Indice tutti i titoli","Indice titoli esclusi","Stat. test","p-value")
  return(tabella)
}


